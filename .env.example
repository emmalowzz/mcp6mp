# Optional, server-side only. Never prefix with VITE_.
# If set, it is sent as a Bearer token to Smithery-hosted MCP servers (gateway check and NutriBalance). Never returned to the browser.
SMITHERY_API_KEY=
# Optional Smithery profile id, if the server's Smithery page says it needs one. Sent with ?api_key= as &profile=.
SMITHERY_PROFILE=
# NutriBalance MCP server used by the My Daily Needs tab (/api/nutrition). Defaults to the Smithery URL below.
NUTRIBALANCE_MCP_URL=https://server.smithery.ai/NutriBalance/nutribalance-mcp
PORT=3000
